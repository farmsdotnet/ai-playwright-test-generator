# Only needed for the optional TestRail ingestion path (python cli.py --testrail-case ...).
# Not required for the AC.md path - Claude Code needs no credentials from this project at all.
# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.
TESTRAIL_URL=https://yourcompany.testrail.io
TESTRAIL_EMAIL=you@example.com
TESTRAIL_API_KEY=your-testrail-api-key
